# ============================================================
# ClaimAppeal AI — Environment Variables
# Copy this to .env.local and fill in your values
# NEVER commit .env.local to git
# ============================================================

# -------------------------
# SUPABASE (PUBLIC — safe to expose to browser)
# -------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# -------------------------
# SUPABASE (SERVER ONLY — SENSITIVE)
# -------------------------
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -------------------------
# STRIPE (SERVER ONLY — SENSITIVE)
# -------------------------
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# -------------------------
# STRIPE (PUBLIC — safe to expose to browser)
# -------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# -------------------------
# AI PROVIDER (SERVER ONLY)
# -------------------------
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
# OPENAI_API_KEY=sk-your-openai-api-key  # Optional, for future redundancy

# -------------------------
# EMAIL (SERVER ONLY — SENSITIVE)
# -------------------------
RESEND_API_KEY=re_your-resend-api-key
EMAIL_FROM=noreply@yourdomain.com

# -------------------------
# APP CONFIG (SERVER ONLY)
# -------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3001
ADMIN_EMAILS=your-admin-email@example.com  # Comma-separated list of admin emails
