# ============================================================
# ClaimAppeal AI — Environment Variables
# Copy this to .env.local and fill in your values
# NEVER commit .env.local to git
# ============================================================

# -------------------------
# SUPABASE (PUBLIC — safe to expose to browser)
# -------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# -------------------------
# SUPABASE (SERVER ONLY — SENSITIVE)
# -------------------------
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -------------------------
# DODO PAYMENTS (INDIA & GLOBAL)
# -------------------------
DODO_PAYMENTS_API_KEY=your-dodo-api-key
DODO_PAYMENTS_ENVIRONMENT=test_mode # or live_mode
DODO_PAYMENTS_WEBHOOK_KEY=your-webhook-secret
DODO_PRO_PRODUCT_ID=pdt_your-pro-product-id
DODO_BUSINESS_PRODUCT_ID=pdt_your-business-product-id

# -------------------------
# AI PROVIDER (SERVER ONLY)
# -------------------------
AI_PROVIDER=openrouter
AI_MODEL=inclusionai/ling-3.0-flash-sante:free
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
# GEMINI_API_KEY=your-gemini-api-key
# GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# -------------------------
# EMAIL (SERVER ONLY — SENSITIVE)
# -------------------------
RESEND_API_KEY=re_your-resend-api-key
EMAIL_FROM=onboarding@resend.dev

# -------------------------
# APP CONFIG (SERVER ONLY)
# -------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3001
ADMIN_EMAILS=your-admin-email@example.com
